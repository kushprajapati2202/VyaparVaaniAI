# Copy to .env in this folder. `adk deploy agent_engine` forwards these as runtime env vars.

# --- Model access ---
# Vertex AI (recommended for Agent Engine / Gemini Enterprise)
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Local dev alternative: GOOGLE_GENAI_USE_VERTEXAI=False and GOOGLE_API_KEY=...

OWNER_AGENT_MODEL=gemini-3.5-flash

# --- VyaparVaani backend (Cloud Run URL) ---
VYAPARVAANI_API_URL=https://vyaparvaani-xxxxx-el.a.run.app
# Must equal ENTERPRISE_AGENT_TOKEN on the backend. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
VYAPARVAANI_AGENT_TOKEN=

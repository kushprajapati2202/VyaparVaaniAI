# ==============================================================================
# VYAPARVAANI AI - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="VyaparVaani AI"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-key-in-production-vyaparvaani-2026

# Google Gemini / Google Cloud
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
# Gemini Realtime / Live Model ID for WebSockets
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp
# Gemini standard model for complex reasoning / ADK
GEMINI_REASONING_MODEL=gemini-2.0-flash

# Database Configuration
# Local SQLite for immediate local zero-dependency development/demo:
DATABASE_URL=sqlite+aiosqlite:///./vyaparvaani.db
# Cloud SQL / Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vyaparvaani

# Server Settings
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]

# Human Approval Thresholds (Policy Rules)
MAX_UNAPPROVED_ORDER_AMOUNT=15000.0
MAX_CREDIT_UTILIZATION_PERCENT=0.85
MAX_UNAPPROVED_DISCOUNT_PERCENT=0.10

# Audio / Voice Settings
SAMPLE_RATE=16000
AUDIO_CHANNELS=1
CHUNK_SIZE=1024

# ==============================================================================
# VYAPARVAANI AI - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="VyaparVaani AI"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-key-in-production-vyaparvaani-2026

# Google Gemini / Google Cloud
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_API_VERSION=v1beta
# Native audio-to-audio Live model (bidiGenerateContent)
GEMINI_LIVE_MODEL=gemini-3.8-live
# Text model used only in fallback mode (Live unavailable)
GEMINI_REASONING_MODEL=gemini-3.5-flash
# Prebuilt Gemini voice for spoken replies
GEMINI_VOICE=Kore
# Cloud Run with Vertex AI instead of an API key (uses the service account / ADC)
GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Voice turn-taking (Gemini server-side VAD) and cost control
VAD_SILENCE_MS=500
VAD_PREFIX_PADDING_MS=300
LIVE_RESET_CONTEXT_AFTER_TXN=True
LIVE_CONTEXT_TRIGGER_TOKENS=12000
LIVE_CONTEXT_TARGET_TOKENS=6000

# Transaction safety
UNDO_WINDOW_MINUTES=15
DUPLICATE_WINDOW_SECONDS=120
LARGE_PAYMENT_WARNING_AMOUNT=25000

# ROI assumptions shown on the Analytics page (all overridable)
MANUAL_SECONDS_PER_TRANSACTION=95
OPERATOR_COST_PER_HOUR_INR=120
USD_TO_INR=84
SUBSCRIPTION_PRICE_INR_PER_MONTH=299

# Database Configuration
# Local SQLite for immediate local zero-dependency development/demo:
DATABASE_URL=sqlite+aiosqlite:///./vyaparvaani.db
# Cloud SQL / Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vyaparvaani

# Server Settings
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]

# Human Approval Thresholds (Policy Rules)
MAX_UNAPPROVED_ORDER_AMOUNT=15000.0
MAX_CREDIT_UTILIZATION_PERCENT=0.85
MAX_UNAPPROVED_DISCOUNT_PERCENT=0.10

# Audio / Voice Settings
SAMPLE_RATE=16000
AUDIO_CHANNELS=1
CHUNK_SIZE=1024
